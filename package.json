{
  "name": "asnawiyyah",
  "version": "1.0.0",
  "private": true,
  "description": "Portal Resmi PPTQ Asnawiyyah Pilangwetan",
  "scripts": {
    "build:css": "npx tailwindcss -i ./css/input.css -o ./css/styles.min.css --minify",
    "watch:css": "npx tailwindcss -i ./css/input.css -o ./css/styles.min.css --watch",
    "build": "npm run build:css",
    "backend:status": "cd legacy && clasp status",
    "backend:push": "cd legacy && clasp push -f",
    "backend:pull": "cd legacy && clasp pull",
    "backend:split": "node scripts/split_backend.js",
    "backend:bundle": "node scripts/bundle_backend.js",
    "test:syntax": "node scripts/check_syntax.js",
    "test": "node scripts/run_all_tests.js",
    "validate": "npm run build && npm run test"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
