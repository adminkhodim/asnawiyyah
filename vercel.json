{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/berita/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/administrator",
      "destination": "/"
    },
    {
      "source": "/sd-islam-unggulan",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/sd-islam-unggulan/",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/kalender.ics",
      "destination": "/api/kalender"
    },
    {
      "source": "/calendar.ics",
      "destination": "/api/kalender"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}