{
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/administrator",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/berita/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:match*",
      "destination": "/"
    },
    {
      "source": "/app",
      "destination": "/"
    },
    {
      "source": "/app/:match*",
      "destination": "/"
    },
    {
      "source": "/sd-islam-unggulan",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/sd-islam-unggulan/",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/kalender.ics",
      "destination": "/api/kalender"
    },
    {
      "source": "/calendar.ics",
      "destination": "/api/kalender"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}