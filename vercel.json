{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/berita/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/administrator",
      "destination": "/index.html"
    },
    {
      "source": "/sd-islam-unggulan",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/sd-islam-unggulan/",
      "destination": "/sd-islam-unggulan/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}