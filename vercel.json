{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/berita",
      "destination": "https://asnawiyyah-news-platform.vercel.app/berita"
    },
    {
      "source": "/berita/:match*",
      "destination": "https://asnawiyyah-news-platform.vercel.app/berita/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}